# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DETACTICA_SECRET_KEY=

# Host port and address; use 127.0.0.1 behind a reverse proxy on the same host.
HOST_PORT=8080
HOST_BIND=0.0.0.0

# Leave empty for SQLite in the persistent Docker volume.
# PostgreSQL example: postgresql://user:password@database-host:5432/detactica
DATABASE_URL=

# Optional: Gmail App Password for the existing sender deetactica@gmail.com.
DETACTICA_GMAIL_APP_PASSWORD=

# Set both to 1 when served through one trusted HTTPS reverse proxy.
DETACTICA_SECURE_COOKIES=0
DETACTICA_TRUST_PROXY=0
